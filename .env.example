DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/business_collab?schema=public"

# Generate a random secret, for example with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://127.0.0.1:3000"

# Pin to the existing founder account ID, never a client-supplied email.
SAFETY_FOUNDER_USER_ID=""
# Comma-separated existing account IDs. Only assigned cases are visible to them.
SAFETY_TEAM_USER_IDS=""
# Keep disabled until provider/privacy setup and signed callback tests are complete.
DIDIT_ENABLED="false"
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_APPLICATION_ID=""
DIDIT_WEBHOOK_SECRET=""

# Prisma Postgres: pooled TCP URL above for application traffic; direct TCP URL for migrations.
DIRECT_URL=""
# Keep database for local development. Select vercel-blob after connecting a PRIVATE store.
MEDIA_STORAGE="database"
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
# VERCEL_OIDC_TOKEN is supplied by Vercel when the private store is connected.
# Protected maintenance endpoint; never put this secret in a URL or client variable.
CRON_SECRET=""

# Founder safety email. Set the mailbox password privately in Vercel.
# Sending stays disabled until explicitly enabled and tested.
SAFETY_EMAIL_ENABLED=false
SMTP_USER=ffounder@example.com
SMTP_FROM=ffounder@example.com
SMTP_PASSWORD=
