{
  "name": "business-collab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:accounts": "node tests/auth.integration.mjs",
    "test:collaborations": "node tests/collaborations.integration.mjs",
    "test:chat": "node tests/chat.integration.mjs",
    "test:reviews": "node tests/reviews.integration.mjs",
    "safety:worker": "node --env-file=.env --experimental-strip-types scripts/safety-worker.mjs",
    "safety:sweep": "node --env-file=.env --experimental-strip-types scripts/safety-worker.mjs --once",
    "test:safety": "node --env-file=.env --experimental-strip-types tests/safety.integration.mjs",
    "hosting:check": "node scripts/check-hosting.mjs",
    "hosting:build": "npm run hosting:check && npm run build",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.10",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "next": "16.4.2",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
